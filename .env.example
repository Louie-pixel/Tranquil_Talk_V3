# Generate a random key; do not use this text as your secret.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Native server only (Compose supplies its own MongoDB URI):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&serverSelectionTimeoutMS=5000
BIND_ADDRESS=127.0.0.1
PORT=8080
WEB_ROOT=web
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
MAILBOX_PORT=8025
# Local development captures email in Mailpit. Production Compose forces resend.
MAIL_MODE=mailpit
# Resend API key and a sender on a verified domain. Never commit real values.
RESEND_API_KEY=
MAIL_FROM=
# Example: turns:turn.your-domain.com:5349?transport=tcp
TURN_URL=
TURN_SECRET=
# Production only: a hostname whose DNS points to your server.
DOMAIN=
# Explicit operator opt-in. Administrator previews only; never sends patient locations.
CLINIC_OSM_ENABLED=false
